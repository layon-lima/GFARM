# MODELO — NUNCA usar credenciais de exemplo em produção.
# Copie para backend/.env e preencha com valores secretos reais, fora do GitHub.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ESTQ_CONFIGURAR
DB_USER=ESTQ_CONFIGURAR
DB_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
SECRET_KEY=SUBSTITUIR_POR_SEGREDO_ALEATORIO_FORTE
APP_HOST=127.0.0.1
APP_PORT=8000

# Opcional: origens públicas adicionais, separadas por vírgula.
# Se a PWA é servida pelo mesmo domínio da API, pode permanecer vazio.
CORS_ALLOWED_ORIGINS=
