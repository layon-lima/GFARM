{
  "manifest_version": 3,
  "name": "GFARM — Captura de XML da NF-e",
  "version": "0.3.0",
  "description": "Captura XML de NF-e e consulta lotes SEFAZ com certificado Windows selecionado no GFARM.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "file:///*",
    "https://estoque.fazendanovohorizonte.com/*",
    "https://www1.nfe.fazenda.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://estoque.fazendanovohorizonte.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.fsist.com.br/*",
        "https://chaves.fsist.com.br/*"
      ],
      "js": [
        "fsist.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
